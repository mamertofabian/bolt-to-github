{
  "name": "bolt-to-github",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "watch": "vite build --watch",
    "watch:dev": "vite build --mode development --watch",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.{js,ts,svelte}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,svelte}\" --fix",
    "lint-check": "pnpm run lint && pnpm run check",
    "maid": "./scripts/maid",
    "maid:schema": "./scripts/maid validate --manifest-dir manifests --mode schema",
    "maid:behavioral": "./scripts/maid validate --manifest-dir manifests --mode behavioral",
    "maid:implementation": "./scripts/maid validate --manifest-dir manifests --mode implementation",
    "maid:test": "./scripts/maid test --manifest-dir manifests",
    "maid:files": "./scripts/maid files --manifest-dir manifests",
    "test": "vitest run --coverage",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "test:watch:coverage": "vitest watch --coverage",
    "test:failed-files": "node scripts/find-failed-tests.js",
    "clean:test-comments": "npx tsx scripts/remove-test-comments.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,svelte,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/dompurify": "^3.2.0",
    "dompurify": "^3.4.2",
    "fflate": "^0.8.2",
    "ignore": "^6.0.2",
    "lucide-svelte": "^0.460.1",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^4.2.3",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.0.236",
    "@types/node": "^22.19.18",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.5.0",
    "bits-ui": "^0.21.16",
    "clsx": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^2.46.1",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^4.2.20",
    "svelte-check": "^3.8.6",
    "svelte-preprocess": "^5.1.4",
    "tailwind-merge": "^2.6.1",
    "tailwind-variants": "^0.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
